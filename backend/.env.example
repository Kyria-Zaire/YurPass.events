# YurPass Backend — copy to .env or .env.local

APP_NAME=YurPass
APP_ENV=local
DEBUG=false

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

DATABASE_URL=postgresql+psycopg://yurpass:yurpass@localhost:5432/yurpass_dev
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=yurpass_refresh_token

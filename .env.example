# =============================================================================
# YurPass — Variables d'environnement (exemple)
# Copier vers .env.local et remplir les valeurs.
# Ne jamais committer de fichiers .env avec de vraies valeurs.
# =============================================================================

# --- App ---
APP_ENV=
APP_NAME=

# --- Backend ---
BACKEND_PORT=

# --- Frontend ---
WEB_PORT=
ADMIN_PORT=

# --- Database ---
DATABASE_URL=

# --- Redis ---
REDIS_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Security ---
JWT_SECRET=
TURNSTILE_SECRET_KEY=

# --- Storage ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
